{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "_posts/**",
    "src/routeTree.gen.ts",
    ".amp/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ]
}
